require 'base64'
require 'fileutils'

default_platform(:android)

# ──────────────────────────────────────────────
#  Вспомогательные методы
# ──────────────────────────────────────────────

def ensure_env(key)
  value = ENV[key]
  UI.user_error!("Переменная окружения '#{key}' не задана. Проверь .env или экспортируй её вручную.") if value.nil? || value.empty?
  value
end

def build_aab
  gradle(
    task: ":composeApp:bundle",
    build_type: "Release",
    project_dir: ".",
    properties: {
      "android.injected.signing.store.file"     => ensure_env("KEYSTORE_PATH"),
      "android.injected.signing.store.password" => ensure_env("KEYSTORE_STORE_PASSWORD"),
      "android.injected.signing.key.alias"      => ensure_env("KEYSTORE_KEY_ALIAS"),
      "android.injected.signing.key.password"   => ensure_env("KEYSTORE_KEY_PASSWORD"),
    }
  )
end

# ──────────────────────────────────────────────
#  Платформа Android
# ──────────────────────────────────────────────

platform :android do

  # ---- Internal Testing ----
  desc "Собрать AAB и залить в Internal Testing"
  lane :deploy_internal do
    build_aab
    upload_to_play_store(
      track: "internal",
      aab: "composeApp/build/outputs/bundle/release/composeApp-release.aab",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "draft"
    )
    UI.success("✅ Загружено в Internal Testing!")
  end

  # ---- Beta (Open Testing) ----
  desc "Собрать AAB и залить в Beta (Open Testing)"
  lane :deploy_beta do
    build_aab
    upload_to_play_store(
      track: "beta",
      aab: "composeApp/build/outputs/bundle/release/composeApp-release.aab",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
    UI.success("✅ Загружено в Beta!")
  end

  # ---- Alpha ----
  desc "Собрать AAB и залить в Alpha"
  lane :deploy_alpha do
    build_aab
    upload_to_play_store(
      track: "alpha",
      aab: "composeApp/build/outputs/bundle/release/composeApp-release.aab",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
    UI.success("✅ Загружено в Alpha!")
  end

  # ---- Production ----
  desc "Собрать AAB и залить в Production (rollout 10% по умолчанию)"
  lane :deploy_production do |options|
    rollout = options[:rollout] || "0.1"
    build_aab
    upload_to_play_store(
      track: "production",
      aab: "composeApp/build/outputs/bundle/release/composeApp-release.aab",
      skip_upload_apk: true,
      rollout: rollout,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
    UI.success("✅ Загружено в Production (rollout #{(rollout.to_f * 100).to_i}%)!")
  end

  # ---- Только сборка без загрузки (проверка) ----
  desc "Только собрать подписанный AAB"
  lane :build_only do
    build_aab
    UI.success("✅ AAB собран: composeApp/build/outputs/bundle/release/composeApp-release.aab")
  end

  # ---- Поднять versionCode автоматически ----
  desc "Поднять versionCode + собрать + Internal"
  lane :bump_and_deploy do
    # Читаем текущий versionCode из Play Store и ставим +1
    version_codes = google_play_track_version_codes(track: "internal")
    new_version_code = (version_codes.max || 0) + 1
    UI.message("Новый versionCode: #{new_version_code}")

    # Патчим build.gradle.kts
    path = "composeApp/build.gradle.kts"
    content = File.read(path)
    content.gsub!(/versionCode\s*=\s*\d+/, "versionCode = #{new_version_code}")
    File.write(path, content)

    build_aab

    upload_to_play_store(
      track: "internal",
      aab: "composeApp/build/outputs/bundle/release/composeApp-release.aab",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "draft"
    )
    UI.success("✅ versionCode #{new_version_code} загружен в Internal Testing!")
  end

end

# ──────────────────────────────────────────────
#  Платформа iOS
# ──────────────────────────────────────────────

platform :ios do

  # Общий хелпер: импортирует сертификат и provisioning profile из base64-секретов
  def setup_ios_signing
    setup_ci(force: true)

    # Декодируем .p12 из base64
    cert_path = "#{ENV['RUNNER_TEMP']}/apple_cert.p12"
    File.binwrite(cert_path, Base64.decode64(ensure_env("APPLE_CERTIFICATE_P12")))

    import_certificate(
      certificate_path:     cert_path,
      certificate_password: ensure_env("APPLE_CERTIFICATE_PASSWORD"),
      keychain_name:        ENV["MATCH_KEYCHAIN_NAME"],
      keychain_password:    ENV["MATCH_KEYCHAIN_PASSWORD"]
    )

    # Декодируем .mobileprovision из base64
    profile_dir = "#{Dir.home}/Library/MobileDevice/Provisioning Profiles"
    FileUtils.mkdir_p(profile_dir)
    profile_path = "#{profile_dir}/release.mobileprovision"
    File.binwrite(profile_path, Base64.decode64(ensure_env("APPLE_PROVISIONING_PROFILE")))

    profile_path
  end

  # ---- TestFlight ----
  desc "Собрать IPA и загрузить в TestFlight"
  lane :deploy_testflight do
    profile_path = setup_ios_signing

    # App Store Connect API key — избавляет от 2FA
    api_key = app_store_connect_api_key(
      key_id:                ensure_env("APP_STORE_CONNECT_KEY_ID"),
      issuer_id:             ensure_env("APP_STORE_CONNECT_ISSUER_ID"),
      key_content:           ensure_env("APP_STORE_CONNECT_API_KEY"),
      is_key_content_base64: true
    )

    # Поднимаем build number из переменной CI
    build_number = ENV["BUILD_NUMBER"]
    unless build_number.nil? || build_number.empty?
      increment_build_number(
        build_number: build_number,
        xcodeproj:    "iosApp/iosApp.xcodeproj"
      )
    end

    build_app(
      project:       "iosApp/iosApp.xcodeproj",
      scheme:        "iosApp",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "com.iruna.app" => profile_path
        }
      },
      xcargs: "CODE_SIGN_STYLE=Manual PROVISIONING_PROFILE_SPECIFIER='release'"
    )

    upload_to_testflight(
      api_key:                           api_key,
      skip_waiting_for_build_processing: true
    )

    UI.success("✅ Загружено в TestFlight!")
  end

  # ---- Только сборка (без загрузки) ----
  desc "Только собрать IPA, без загрузки в TestFlight"
  lane :build_only_ios do
    setup_ios_signing

    build_app(
      project:          "iosApp/iosApp.xcodeproj",
      scheme:           "iosApp",
      configuration:    "Release",
      export_method:    "app-store",
      skip_package_ipa: true
    )

    UI.success("✅ iOS фреймворк собран!")
  end

end
