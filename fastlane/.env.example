# ──────────────────────────────────────────────────────────────────────
# Скопируй этот файл в fastlane/.env и заполни реальными значениями.
# fastlane/.env автоматически подхватывается при запуске команд.
# НЕ коммить fastlane/.env в git!
# ──────────────────────────────────────────────────────────────────────

# Путь к keystore-файлу (абсолютный или относительный от корня проекта)
KEYSTORE_PATH=/absolute/path/to/your/release.keystore

# Пароль keystore
KEYSTORE_STORE_PASSWORD=your_store_password

# Alias ключа внутри keystore
KEYSTORE_KEY_ALIAS=your_key_alias

# Пароль ключа
KEYSTORE_KEY_PASSWORD=your_key_password

# Путь к JSON-ключу сервисного аккаунта Google Play
# (скачать в Google Play Console → Настройки → API-доступ)
PLAY_STORE_JSON_KEY=/absolute/path/to/play-store-key.json
